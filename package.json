{
  "scripts": {
    "build": "zile",
    "changeset:publish": "zile publish:prepare && changeset publish && zile publish:post",
    "changeset:version": "changeset version",
    "check": "vp check --fix",
    "check:budgets": "node scripts/budgets.ts",
    "check:types": "tsc",
    "dev": "zile dev",
    "test": "vp test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zile": "catalog:",
    "zyzz": "catalog:"
  },
  "packageManager": "pnpm@12.18.0",
  "[!start-pkg]": "",
  "name": "vocs",
  "version": "2.12.0",
  "license": "MIT",
  "description": "Documentation you talk to",
  "homepage": "https://vocs.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wevm/vocs.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "src": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "src": "./src/client/index.ts",
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./react": {
      "src": "./src/react/index.ts",
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./server": {
      "src": "./src/server/index.ts",
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./vite": {
      "src": "./src/vite/index.ts",
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./vite/virtual": {
      "types": "./dist/vite/virtual.d.ts",
      "src": "./src/vite/virtual.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "catalog:",
    "nanocode-ts": "catalog:",
    "xstate": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
