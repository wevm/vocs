{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/docs/*"] },
  "compatibility_date": "2026-11-01",
  // Saved pages. Local development creates the namespace. Set its ID before a deploy.
  "kv_namespaces": [{ "binding": "PAGES", "id": "vocs-pages" }],
  "main": "./src/worker.ts",
  "name": "vocs-playground-custom",
  "ratelimits": [
    { "name": "MODEL_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
  ],
}
