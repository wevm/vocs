// Routes model requests to the stand-in model in `test/workers/model`. The rate limit is sized
// for the end-to-end suite, which sends more model requests in one minute than one reader.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/docs/*"] },
  "compatibility_date": "2026-11-01",
  "kv_namespaces": [{ "binding": "PAGES", "id": "vocs-pages" }],
  "main": "./src/worker.ts",
  "name": "vocs-playground-custom",
  "ratelimits": [
    {
      "name": "MODEL_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 },
    },
  ],
  "services": [{ "binding": "MODEL", "service": "vocs-test-model" }],
}
